rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() > 0;
    }

    function isValidDiagnosis(data) {
      return data.userId == request.auth.uid
        && data.diseaseName is string
        && data.confidence is number
        && data.explanation is string
        && data.medications is string
        && data.precautions is string;
    }

    // Collections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }

    match /diagnoses/{diagnosisId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidDiagnosis(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
